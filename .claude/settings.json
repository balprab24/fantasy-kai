{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && ./scripts/session-check.sh --hook",
            "timeout": 30,
            "statusMessage": "Checking what is actually true about the repo..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git * push --force *)",
      "Bash(git * push -f *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr merge *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker compose down *)",
      "Bash(docker compose * down *)",
      "Bash(./scripts/db-restore.sh *)"
    ]
  }
}
