# Copy to .env and adjust. .env is gitignored -- never commit real secrets.

# --- docker-compose: Postgres ---
POSTGRES_DB=fantasykai
POSTGRES_USER=fantasykai
POSTGRES_PASSWORD=fantasykai

# Host port for the Postgres container. Defaults to 5433 rather than 5432 so the
# project coexists with a system/Homebrew Postgres. If 5432 is free on your
# machine you can set it to 5432 here and update DB_URL to match.
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- backend: datasource (application.yml defaults match the values above) ---
DB_URL=jdbc:postgresql://localhost:5433/fantasykai
DB_USERNAME=fantasykai
DB_PASSWORD=fantasykai

# --- backend: auth (Phase 5) ---
# HS256 signing key for access tokens. At least 32 bytes or the app refuses to
# start. Generate one with:  openssl rand -base64 48
# This value is a placeholder for local development only. Never reuse it.
JWT_SECRET=local-development-only-not-a-real-secret-change-me-please

# Redis, for the /auth rate limiter. Matches docker-compose.
REDIS_HOST=localhost

# CORS allowlist for the backend -- comma-separated browser origins, scheme
# included, no trailing slash. Locally this is the Next.js dev server; in
# production it is the Vercel origins and it is set in deploy/.env on the VM,
# never here. application.yml defaults to the value below when it is unset.
ALLOWED_ORIGINS=http://localhost:3000

# Frontend (Phase 5c). The browser reads this at build time, so it is public by
# construction -- never put anything here that is not already public. In
# production it is https://api.<your-domain>, set in Vercel's project settings.
#
# That hostname must share a registrable domain with the site itself, and the
# reason is the refresh cookie: it is SameSite=Strict, and Strict is decided by
# registrable domain rather than by origin. localhost:3000 -> localhost:8080 is
# same-site (ports do not count), which is exactly why the constraint is
# invisible in development. See deploy/README.md.
NEXT_PUBLIC_API_URL=http://localhost:8080
