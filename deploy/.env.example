# Copy to deploy/.env on the VM and fill in. deploy/.env is gitignored.
#
# Every variable here is marked required in compose.prod.yml (${VAR:?...}), so a
# missing one fails at `docker compose up` naming the variable -- rather than
# starting a container that dies later for a reason you have to go and read.

# --- the domain ---
# The API hostname. Caddy obtains a certificate for exactly this name, so the
# DNS A record must already point here.
#
# It MUST share a registrable domain with the frontend origin below. That is not
# cosmetic: the refresh token is a SameSite=Strict cookie, and Strict is decided
# by registrable domain, not by origin. fantasykai.dev + api.fantasykai.dev are
# same-site and the cookie is sent; a .vercel.app frontend against a .fly.dev API
# would be cross-site and the cookie would never be sent at all -- every reload
# silently logging the user out. localhost:3000 -> localhost:8080 hides this in
# development, because ports do not affect same-site.
API_DOMAIN=api.example.com

# Contact address for Let's Encrypt. Required -- Caddy will not parse an empty
# `email` directive.
ACME_EMAIL=you@example.com

# --- CORS ---
# Comma-separated browser origins, scheme included, no trailing slash. These are
# where the frontend is served from, not where the API lives.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- database ---
POSTGRES_DB=fantasykai
POSTGRES_USER=fantasykai
# Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- auth ---
# HS256 signing key. At least 32 bytes or the app refuses to start.
# Generate one:  openssl rand -base64 48
# Never reuse the development value from the repo root .env.example.
JWT_SECRET=
