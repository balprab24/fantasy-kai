# TLS termination and the only thing on this machine listening to the internet.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, which is what
# closes handoff section 8's transport row: HTTPS and HSTS could not be
# satisfied locally, and that was the last thing standing between Phase 5 and
# "a site you can log into".

{
	# Required, not optional. Anonymous ACME works, but a contact address is
	# what turns a certificate about to expire into an email instead of an
	# outage. Caddy refuses to parse `email` with an empty value, so
	# compose.prod.yml marks ACME_EMAIL required and the failure lands at
	# `docker compose up` naming the variable -- rather than inside a container
	# that will not start, which is where it landed the first time.
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy backend:8080

	# THIS BLOCK IS THE RATE LIMITER. Do not add `trusted_proxies` here.
	#
	# Not a figure of speech. The 5/min limit on /api/v1/auth/** is not
	# enforced by the application in any meaningful sense -- measured, not
	# assumed. AuthRateLimitTests sends six logins carrying a VARYING FORGED
	# X-Forwarded-For and gets 401, not 429: six forged addresses, six fresh
	# buckets. deploy/README.md claimed the opposite until 2026-09-21, and the
	# claim survived because nothing executed it.
	#
	# AuthRateLimitFilter keys its bucket on X-Forwarded-For and falls back to
	# getRemoteAddr(). Both paths trust the header: application.yml sets
	# server.forward-headers-strategy=framework, so Spring's
	# ForwardedHeaderFilter has ALREADY rewritten getRemoteAddr() from the
	# forged value before the filter runs. There is no branch in the Java that
	# resists this.
	#
	# What resists it is Caddy's default -- no trusted_proxies configured --
	# which DISCARDS an incoming X-Forwarded-For and writes the real peer. Plus
	# compose.prod.yml giving the backend `expose` and no published port, so
	# nothing can reach it except through here. Both halves are load-bearing.
	#
	# Configuring trusted_proxies (for a CDN, or Cloudflare's orange cloud)
	# turns the first half off and makes the header client-controlled again --
	# converting the limiter into decoration with no error and no log line. The
	# same filter would have been wrong on Fly for exactly this reason: Fly
	# appends to a client-supplied header rather than replacing it.
	#
	# Prove it by forging the header against the DEPLOYED site, through Caddy.
	# See deploy/README.md, acceptance checks 4a and 4b.

	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
