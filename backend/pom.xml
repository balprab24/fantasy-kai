<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.fantasykai</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>fantasy-kai-backend</name>
    <description>Fantasy football stats platform - scoring engine and read API</description>

    <properties>
        <java.version>25</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <bucket4j.version>8.20.0</bucket4j.version>

        <!--
          Ahead of the parent, deliberately, and this is a security pin rather
          than a version preference.

          Spring Boot 3.5's OSS support ended 2026-06-30 and 3.5.16 (released
          2026-06-25) was the last OSS release of the line. There will not be a
          3.5.17, so the Tomcat this parent manages (10.1.55) is frozen at
          whatever CVEs it had on that date.

          Reading Apache's own affected ranges (tomcat.apache.org/security-10.html),
          10.1.55 falls inside every advisory fixed in 10.1.56, 10.1.57 and
          10.1.59: 19 CVEs, four of them Important. CVE-2026-65182 (security
          constraint bypass), CVE-2026-68569 (principal lookup fails open),
          CVE-2026-65927 (RewriteValve access-control bypass), CVE-2026-68763
          (HTTP/2 allocation-leak DoS). 10.1.58's release vote failed, so 10.1.59
          is the next version that exists, not a skipped one.

          Most are likely unreachable in this application: it authenticates with
          Spring Security rather than a Tomcat realm or a servlet security
          constraint, and uses no RewriteValve, DIGEST, FORM auth, WebSocket or
          clustering. "Likely unreachable" is a judgement about today's code,
          though, and the pin costs one line. Do not weaken it to that argument.

          Verify the pin TOOK rather than merely being declared:
              unzip -l target/backend-0.0.1-SNAPSHOT.jar | grep tomcat-embed-core

          A stopgap. The fix is Boot 4, north-star section 10 row 11.5.
        -->
        <tomcat.version>10.1.59</tomcat.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Flyway owns the schema from commit 1. Since Flyway 10 the PostgreSQL
             dialect lives in its own artifact; without it startup fails. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- nflverse ships plain CSV; parse it rather than adding a second runtime. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Phase 5. The filter chain is default-deny; see north-star section 2. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Argon2PasswordEncoder delegates to BouncyCastle and does not declare it.
             Without this the app starts fine and then throws on the first register
             or login, which reads as an auth bug rather than a missing jar. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>

        <!-- HS256 access tokens. jjwt over Spring's oauth2-resource-server because
             the token is ours, symmetric, and 15 minutes long: there is no
             authorization server and no JWK set to fetch. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Rate limiting, handoff section 8. Redis has been running in
             docker-compose since Phase 0 and used by nothing; this is the first
             thing to claim it, and Phase 11's ruleset cache will be the second. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-lettuce</artifactId>
            <version>${bucket4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The rate limiter is backed by Redis, so proving "the 6th login is 429"
             needs a real Redis, the same way the schema tests need a real Postgres. -->
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>2.2.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- `/usr/libexec/java_home -v 25` returns the newest JDK it can find and
                 exits 0 when 25 is absent, so `JAVA_HOME=$(...)` silently selects 21 and
                 the build dies at `release version 25 not supported`: an error about the
                 compiler, raised by a line that looked like it chose one. That cost the
                 daily ingest three days in September 2026, because the stale-jar guard in
                 scripts/ingest-once.sh refused to run and its remedy was a build that
                 could not run either. Fail on the JDK, and name it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-jdk</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                    <message>This build needs JDK ${java.version} or newer. `java_home -v ${java.version}` exits 0 and returns the newest JDK it has even when ${java.version} is missing, so check `java -version`, not the exit code. Install: brew install --cask temurin@${java.version}</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
