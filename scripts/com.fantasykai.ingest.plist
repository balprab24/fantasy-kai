<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily current-season ingest.

  This is a TEMPLATE. The three __REPO__ paths below are placeholders -- a
  checkout's absolute path is not knowable at commit time.

  Install:
      ./scripts/install-ingest.sh

  It substitutes them, writes the result to ~/Library/LaunchAgents/, loads it,
  and fails loudly if the job did not land. Do not copy this file by hand; the
  hand-edit instruction that used to live here was followed exactly zero times.

  Check:  launchctl list | grep fantasykai
  Run now: launchctl start com.fantasykai.ingest
  Remove: launchctl unload ~/Library/LaunchAgents/com.fantasykai.ingest.plist

  StartCalendarInterval uses the machine's local timezone, not ET. See the
  header of ingest-once.sh.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fantasykai.ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/ingest-once.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO__/logs/ingest.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/ingest.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
