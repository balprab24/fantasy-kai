      "html": "<div class=\"ds-console\"><span class=\"ds-seg\">0 PPR</span><span class=\"ds-seg ds-seg-on\">Half PPR</span><span class=\"ds-seg\">PPR</span><span class=\"ds-seam\"></span><span class=\"ds-seg ds-seg-on\">Season</span><span class=\"ds-seg\">Per game</span></div>",
      "css": ".ds-console{display:inline-flex;align-items:center;gap:2px;padding:6px;border-radius:var(--radius-control,4px);background:var(--color-surface,#0a0f1c);font:400 14px 'Sofia Sans',ui-sans-serif,sans-serif}.ds-seg{display:inline-flex;align-items:center;height:32px;padding:0 12px;border-radius:2px;color:var(--color-mute,#9aa6bd);cursor:pointer}.ds-seg:hover{color:var(--color-ink,#eef2fa)}.ds-seg-on{background:var(--color-lift,#1a2540);color:var(--color-ink,#eef2fa);font-weight:600;box-shadow:inset 0 -2px 0 var(--color-energy,#3d8bff)}.ds-seam{width:1px;height:20px;margin:0 4px;background:rgb(148 170 210 / .13)}"
