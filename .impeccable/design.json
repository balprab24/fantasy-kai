      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 20px;border:0;border-radius:var(--radius-control,4px);background:var(--color-ki,#ff8a3d);color:var(--color-on-ki,#140a02);font:600 15px/1 'Sofia Sans',ui-sans-serif,sans-serif;cursor:pointer;transition:filter .15s}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:active{filter:brightness(.95)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-energy,#3d8bff);outline-offset:2px}"
