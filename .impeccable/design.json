      "css": ".ds-nav{display:flex;height:56px;background:#000}.ds-nav-a{position:relative;display:flex;align-items:center;padding:0 12px;color:var(--color-mute,#9aa6bd);font:400 14px 'Sofia Sans',ui-sans-serif,sans-serif;text-decoration:none;cursor:pointer}.ds-nav-a:hover{color:var(--color-ink,#eef2fa)}.ds-nav-on{color:var(--color-ink,#eef2fa);font-weight:600}.ds-nav-on::after{content:'';position:absolute;left:12px;right:12px;bottom:0;height:2px;background:var(--color-energy,#3d8bff)}"
    },
